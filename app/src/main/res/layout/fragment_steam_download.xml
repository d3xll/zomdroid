<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Login note + login fields -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/block_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/steam_dl_login_group"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tv_login_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/steam_dl_login_note"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <TextView
                    android:id="@+id/tv_slow_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/steam_dl_slow_warning"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorError"/>

                <!-- Saved session block -->
                <LinearLayout
                    android:id="@+id/layout_saved_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_steam"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"/>

                    <TextView
                        android:id="@+id/tv_saved_user"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_steam_logout"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/steam_dl_logout"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Credentials input block -->
                <LinearLayout
                    android:id="@+id/layout_credentials_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/et_dl_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/steam_dl_username"
                        android:inputType="text"
                        android:autofillHints="username"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/et_dl_pass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/steam_dl_password"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:textSize="14sp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_remember_session"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/steam_dl_remember_session"
                        android:checked="true"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Game section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/section_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_dl_build"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_build_42"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/steam_dl_build_42"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_build_41"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/steam_dl_build_41"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/steam_dl_version_note"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:autoLink="web"/>

                <EditText
                    android:id="@+id/et_dl_manifest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/steam_dl_manifest_hint"
                    android:inputType="textNoSuggestions"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tv_dl_connections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/steam_dl_connections_title"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_dl_connections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="2.0"
                    android:valueTo="12.0"
                    android:stepSize="1.0"
                    android:value="6.0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/steam_dl_connections_hint"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_verify_files"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/steam_dl_verify_files"
                    android:checked="true"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/steam_dl_verify_files_hint"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <Button
                    android:id="@+id/btn_dl_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minWidth="160dp"
                    android:text="@string/steam_dl_download_game"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress + console log (shared) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_dl_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_dl_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progress_dl"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:max="100"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_dl_cancel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    android:text="@string/steam_dl_cancel"/>

                <TextView
                    android:id="@+id/tv_dl_status"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:scrollbars="vertical"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>