<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LauncherActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        app:liftOnScroll="false"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIconTint="?attr/colorOnSurface"
            app:theme="@style/AppTheme.Toolbar"/>

        <fragment
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/drawer_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:useCompatPadding="false"
        app:cardPreventCornerOverlap="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Drawer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drawer Header -->
            <LinearLayout
                android:id="@+id/nav_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nav_header_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_header_subtitle"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:dividerColor="?attr/colorOutlineVariant"
                app:dividerInsetStart="16dp"
                app:dividerInsetEnd="16dp" />

            <com.google.android.material.navigation.NavigationView
                android:id="@+id/launcher_nv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:dividerColor="?attr/colorOutlineVariant"
                app:menu="@menu/menu_nav"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerColor="?attr/colorOutlineVariant" />

            <!-- Bottom row: Wiki / Donate / Reddit / GitHub / RimDroid. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?attr/colorSurfaceContainer"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/nav_bottom_wiki"
                        style="@style/AppTheme.ImageButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/mt_icon_menu_book"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/fragment_label_wiki"/>

                    <TextView
                        style="@style/AppTheme.NavBottomLabel"
                        android:text="@string/fragment_label_wiki"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/nav_bottom_donate"
                        style="@style/AppTheme.ImageButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/mt_icon_donate"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/nav_menu_donate"/>

                    <TextView
                        style="@style/AppTheme.NavBottomLabel"
                        android:text="@string/nav_menu_donate"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/nav_bottom_reddit"
                        style="@style/AppTheme.ImageButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_reddit"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/nav_menu_reddit"/>

                    <TextView
                        style="@style/AppTheme.NavBottomLabel"
                        android:text="@string/nav_menu_reddit"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <ImageButton
                            android:id="@+id/nav_bottom_version"
                            style="@style/AppTheme.ImageButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_github"
                            android:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="@string/nav_menu_version"/>

                        <!-- "update available" dot; shown by refreshUpdateBadge() when GitHub has a newer release -->
                        <View
                            android:id="@+id/update_badge"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/update_badge_dot"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <TextView
                        style="@style/AppTheme.NavBottomLabel"
                        android:text="@string/nav_bottom_github"/>
                </LinearLayout>

                <!-- Another launcher by the same author. Deliberately NOT tinted: the whole point is
                     that it is recognisable, and a flat fill would reduce the logo to a silhouette. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/nav_bottom_rimdroid"
                        style="@style/AppTheme.ImageButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_rimdroid"
                        android:contentDescription="@string/nav_bottom_rimdroid"/>

                    <TextView
                        style="@style/AppTheme.NavBottomLabel"
                        android:text="@string/nav_bottom_rimdroid"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.drawerlayout.widget.DrawerLayout>
