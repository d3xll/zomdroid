<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Banner image -->
        <ImageView
            android:id="@+id/game_instance_item_banner_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/banner_build41"
            android:contentDescription="@null"/>

        <!-- Gradient overlay: subtle top vignette, deep bottom scrim for high contrast -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/card_banner_gradient_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Build preset badge (e.g. Build 41, Build 42, etc.) -->
        <TextView
            android:id="@+id/game_instance_item_badge_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Build 41"/>

        <!-- Shown above the name while "Allow server hosting" is on: the game then runs on a
             separate profile, and this is the reminder that the usual saves are not gone. -->
        <TextView
            android:id="@+id/game_instance_item_hosting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_badge_hosting"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/coop_hosting_badge"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/game_instance_item_badge_tv"
            tools:visibility="visible"/>

        <!-- Buttons bottom right -->
        <LinearLayout
            android:id="@+id/game_instance_item_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Overflow first, then settings, then play: the destructive and the rarely used
                 sit furthest from the thumb, the action you came for is last. -->
            <ImageButton
                style="@style/AppTheme.CardActionButton"
                android:id="@+id/game_instance_item_more_ib"
                android:contentDescription="@string/game_instance_manage_storage"
                android:src="@drawable/mt_icon_more_vert"/>

            <ImageButton
                style="@style/AppTheme.CardActionButton"
                android:id="@+id/game_instance_item_settings_ib"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/game_instance_settings"
                android:src="@drawable/mt_icon_settings"/>

            <ImageButton
                style="@style/AppTheme.CardActionButton.Play"
                android:id="@+id/game_instance_item_launch_ib"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_play"
                android:src="@drawable/mt_icon_play"/>

        </LinearLayout>

        <!-- Instance name bottom left -->
        <TextView
            android:id="@+id/game_instance_item_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/game_instance_item_buttons_layout"
            tools:text="Project Zomboid 41"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
